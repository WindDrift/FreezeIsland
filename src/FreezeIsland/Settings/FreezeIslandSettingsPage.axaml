<local:FreezeIslandSettingsPage x:Class="FreezeIsland.Settings.FreezeIslandSettingsPage"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:ci="http://classisland.tech/schemas/xaml/core"
                               xmlns:fa="using:FluentAvalonia.UI.Controls"
                               xmlns:controls="clr-namespace:FreezeIsland.Controls"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:local="clr-namespace:FreezeIsland.Settings"
                               mc:Ignorable="d"
                               d:DesignHeight="600" d:DesignWidth="800"
                               TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                               Background="{DynamicResource MaterialDesignPaper}"
                               FontFamily="{StaticResource HarmonyOsSans}"
                               TextElement.FontWeight="Regular"
                               TextElement.FontSize="14">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <ci:IconText Glyph="&#xE72E;" Text="键鼠锁定" Margin="0 0 0 8" />

            <Border Margin="0 0 0 8"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ci:FluentIcon Glyph="&#xE72E;"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="FreezeIsland"
                                   FontSize="16"
                                   FontWeight="Medium" />
                        <TextBlock Text="按全局热键锁定键盘与鼠标，再次按下解除。倒计时、锁定与解锁状态会通过全屏提醒和主界面组件呈现。"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 6 0 0">
                            <TextBlock Text="当前状态："
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StatusText"
                                       Text="键鼠未锁定"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ci:IconText Glyph="&#xE713;" Text="热键与锁定范围" Margin="0 16 0 8" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE765;}"
                                   Header="全局热键"
                                   Description="按下此组合键进入倒计时并锁定；倒计时期间再次按下可取消，锁定后再次按下解锁。">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:HotkeyRecorder x:Name="HotkeyRecorderControl" />
                    <Button x:Name="ResetHotkeyButton" Content="恢复默认" />
                </StackPanel>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE765;}"
                                   Header="锁定键盘"
                                   Description="拦截键盘输入；解锁热键始终可用。分区锁定属于实验性功能，需在页面底部开启【实验性功能】后才生效；关闭时锁定整个键盘。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch x:Name="LockKeyboardToggle" />
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="字母区"
                                           Description="A–Z 字母键。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardLettersToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="数字区"
                                           Description="主键盘顶部的 1–0 数字行。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardNumberRowToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="符号区"
                                           Description="主键盘上的标点与符号键，例如 ; = , . / [ ] \ '。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardSymbolsToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="功能键区"
                                           Description="F1–F12 功能键（即 FN 区）。真正的 Fn 键由键盘固件处理，系统钩子无法单独拦截。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardFunctionKeysToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="数字小键盘区"
                                           Description="数字小键盘、NumLock 与小键盘运算符；NumLock 关闭时小键盘方向键也归入此区。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardNumpadToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="编辑与方向键区"
                                           Description="独立的方向键与 Insert、Delete、Home、End、PageUp、PageDown。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardNavigationToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="控制键区"
                                           Description="Esc、Tab、CapsLock、Backspace、Enter、空格。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardControlKeysToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="修饰键区"
                                           Description="Shift、Ctrl、Alt、Win。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardModifiersToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="媒体与系统键"
                                           Description="音量、播放控制、浏览器键、PrintScreen、Pause、ScrollLock 等。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardMediaKeysToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="其他按键"
                                           Description="未归类的按键（IME、厂商自定义键等）。建议保持开启以避免漏锁。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="KeyboardOtherToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE962;}"
                                   Header="锁定鼠标"
                                   Description="拦截鼠标按键与滚轮；可单独冻结指针。展开后可细分要锁定的操作。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch x:Name="LockMouseToggle" />
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="左键"
                                           Description="鼠标左键的按下、释放与双击。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseLeftToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="中键"
                                           Description="鼠标中键（滚轮按下）的按下、释放与双击。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseMiddleToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="右键"
                                           Description="鼠标右键的按下、释放与双击。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseRightToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="侧键"
                                           Description="鼠标 X1/X2 侧键。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseSideButtonsToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="滚轮"
                                           Description="垂直与水平滚动。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseWheelToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="锁定鼠标移动"
                                           Description="开启后鼠标指针将被冻结；关闭时仍可移动指针但不能执行所选操作。默认关闭。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch x:Name="MouseMovementLockToggle" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <ci:IconText Glyph="&#xE711;" Text="排除按键" Margin="0 16 0 8" />

            <Border Margin="0 0 0 8"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="锁定期间仍然可用的键盘按键"
                               FontWeight="Medium" />
                    <TextBlock Text="排除按键属于实验性功能，需在页面底部开启【实验性功能】后才生效；关闭时排除按键不生效。解锁热键始终可用。点击“添加按键”后按下要排除的键；支持音量、媒体等特殊按键，Esc 取消。排除键只放行该键本身，组合键需要同时排除修饰键。Fn 键由键盘固件处理，无法被系统钩子捕获。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <WrapPanel x:Name="ExcludedKeysPanel" />
                    <TextBlock x:Name="NoExcludedKeysText"
                               Text="尚未添加排除按键。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddExcludedKeyButton" Content="添加按键" />
                        <Button x:Name="ClearExcludedKeysButton" Content="清空" />
                    </StackPanel>
                    <TextBlock x:Name="ExcludeKeyStatusText"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ci:IconText Glyph="&#xE916;" Text="时间与提醒" Margin="0 16 0 8" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE916;}"
                                   Header="锁定倒计时"
                                   Description="按下热键后等待指定秒数再锁定。设为 0 可立即锁定。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown x:Name="CountdownBox"
                                       Minimum="0"
                                       Maximum="10"
                                       Increment="1"
                                       FormatString="0"
                                       Width="120" />
                        <TextBlock Text="秒"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEA8F;}"
                                   Header="全屏提醒时长"
                                   Description="锁定与解锁全屏提醒的显示时长。倒计时提示按倒计时秒数单独显示。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown x:Name="NotificationDurationBox"
                                       Minimum="1"
                                       Maximum="10"
                                       Increment="1"
                                       FormatString="0"
                                       Width="120" />
                        <TextBlock Text="秒"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <ci:IconText Glyph="&#xE946;" Text="状态与诊断" Margin="0 16 0 8" />

            <Border Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="输入钩子"
                               FontWeight="Medium" />
                    <TextBlock x:Name="HookStatusText"
                               Text="输入钩子：检查中…"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               IsVisible="False"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ci:IconText Glyph="&#xEEF1;" Text="自动化规则" Margin="0 16 0 8" />

            <Border Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="可供自动化工作流使用的规则"
                               FontWeight="Medium" />
                    <TextBlock Text="在【自动化】→ 编辑工作流的规则集时，可以选择以下规则作为条件："
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 键鼠锁定状态是：已锁定 / 已解锁。倒计时期间视为未锁定；输入钩子不可用时不会判定为已锁定。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 锁定的范围包含：键盘 / 鼠标 / 鼠标移动 / 鼠标左键 / 中键 / 右键 / 侧键 / 滚轮。判定的是当前设置，未锁定时同样可以成立。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="锁定状态或上述设置发生变化时，插件会通知 ClassIsland 重新判定规则集。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ci:IconText Glyph="&#xE7BA;" Text="实验性功能" Margin="0 16 0 8" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7BA;}"
                                   Header="实验性功能"
                                   Description="开启后启用分区锁定键盘与排除按键；关闭时锁定整个键盘，排除按键不生效。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch x:Name="ExperimentalFeaturesToggle" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</local:FreezeIslandSettingsPage>
