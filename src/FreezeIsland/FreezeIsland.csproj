<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CreateCipx>true</CreateCipx>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <AssemblyName>FreezeIsland</AssemblyName>
    <RootNamespace>FreezeIsland</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ClassIslandPluginSdkVersion>2.1.0.1</ClassIslandPluginSdkVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 插件包默认不生成 MD5 汇总，生成脚本依赖 PowerShell 7；发布工作流用 -p:ForceHashSummary=true 打开。 -->
  <Target Name="DisableHashSummary" BeforeTargets="CreateCipx" Condition="'$(ForceHashSummary)' != 'true'">
    <PropertyGroup>
      <GenerateHashSummary>false</GenerateHashSummary>
    </PropertyGroup>
  </Target>

</Project>
